---
import certificatesData from "@/data/certificates.json"
---

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 mt-10">
  {
    certificatesData.map(({ title, issuer, date, hours, tags, file }) => (
      <a
        href={file}
        target="_blank"
        rel="noopener noreferrer"
        class="group relative flex flex-col gap-3 rounded-2xl border border-gray-200/60 dark:border-gray-700/50 bg-white/60 dark:bg-gray-900/40 p-5 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_12px_40px_-8px_rgba(251,191,36,0.18)] hover:border-yellow-400/40 dark:hover:border-yellow-400/30 backdrop-blur-sm"
      >
        {/* Badge decorativo */}
        <div class="flex items-start justify-between gap-2">
          <div class="flex items-center gap-2">
            <div class="flex-shrink-0 size-8 rounded-full bg-yellow-400/15 dark:bg-yellow-400/10 flex items-center justify-center ring-1 ring-yellow-400/30">
              <svg
                class="size-4 text-yellow-500 dark:text-yellow-400"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="8" r="6" />
                <path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11" />
              </svg>
            </div>
            <span class="text-xs text-gray-400 dark:text-gray-500">{date}</span>
          </div>
          {hours && (
            <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-yellow-400/10 text-yellow-600 dark:text-yellow-400 ring-1 ring-yellow-400/20">
              {hours}h
            </span>
          )}
        </div>

        {/* Título */}
        <h3 class="text-sm font-semibold text-gray-800 dark:text-gray-100 leading-snug group-hover:text-yellow-500 dark:group-hover:text-yellow-400 transition-colors duration-200">
          {title}
        </h3>

        {/* Emisor */}
        <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed">
          {issuer}
        </p>

        {/* Tags */}
        <div class="flex flex-wrap gap-1.5 mt-auto pt-2">
          {tags.map((tag) => (
            <span class="text-[11px] px-2 py-0.5 rounded-full bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400">
              {tag}
            </span>
          ))}
        </div>

        {/* Flecha decorativa */}
        <div class="absolute bottom-4 right-4 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
          <svg
            class="size-4 text-yellow-500"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M7 7h10v10" />
            <path d="M7 17 17 7" />
          </svg>
        </div>
      </a>
    ))
  }
</div>
